    "e2e:task051": "node scripts/task051-e2e.mjs",
    "e2e:task052a": "node scripts/task052a-e2e.mjs",
    "smoke": "node --test tests/smoke.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
