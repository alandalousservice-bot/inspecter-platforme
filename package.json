{
  "name": "inspector-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/web",
    "packages/api"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint packages",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:db": "npm run test:db --workspace @inspector/api",
    "test:evolution": "npm run build --workspace @inspector/api && node --test --test-concurrency=1 packages/api/test/product-evolution.integration.mjs packages/api/test/product-evolution-upgrade.integration.mjs",
    "e2e:evolution": "npm run build && node scripts/product-evolution-e2e.mjs",
    "e2e:g3": "node scripts/g3-e2e.mjs",
    "e2e:task075": "node scripts/task075-e2e.mjs",
    "e2e:task045": "node scripts/task045-e2e.mjs",
    "e2e:task051": "node scripts/task051-e2e.mjs",
    "e2e:task052a": "node scripts/task052a-e2e.mjs",
    "e2e:task052": "node scripts/task052-e2e.mjs",
    "e2e:task053": "node scripts/task053-e2e.mjs",
    "e2e:task054": "node scripts/task054-e2e.mjs",
    "e2e:task081": "node scripts/task081-e2e.mjs",
    "e2e:task082": "node scripts/task082-e2e.mjs",
    "e2e:task083": "node scripts/task083-e2e.mjs",
    "e2e:task084": "node scripts/task084-e2e.mjs",
    "e2e:task085": "node scripts/task085-e2e.mjs",
    "e2e:task086": "node scripts/task086-e2e.mjs",
    "e2e:task077d": "node scripts/task077d-e2e.mjs",
    "e2e:task070b": "node scripts/task070b-e2e.mjs",
    "local:uat:init": "node scripts/local-uat.mjs init",
    "local:uat:seed": "node scripts/local-uat.mjs seed",
    "local:uat:api": "node scripts/local-uat.mjs api",
    "local:uat:test": "node --test scripts/local-uat.test.mjs",
    "test:isolation": "node --test scripts/test-schema-safety.test.mjs",
    "local:uat:verify": "node scripts/local-uat-verify.mjs",
    "smoke": "node --test tests/smoke.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
