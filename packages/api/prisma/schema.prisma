generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model District {
  id           String                        @id @default(uuid()) @db.Uuid
  name         String
  externalCode String?
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  memberships  InspectorDistrictMembership[]
  institutions Institution[]
  auditEvents  AuditLog[]
}

model Inspector {
  id           String                        @id @default(uuid()) @db.Uuid
  email        String                        @unique
  passwordHash String
  status       String
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  memberships  InspectorDistrictMembership[]
  sessions     Session[]
  auditEvents  AuditLog[]
}

model InspectorDistrictMembership {
  id          String    @id @default(uuid()) @db.Uuid
  inspectorId String    @db.Uuid
  districtId  String    @db.Uuid
  role        String
  validFrom   DateTime
  validTo     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  inspector   Inspector @relation(fields: [inspectorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  district    District  @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([inspectorId])
  @@index([districtId])
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  inspectorId String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  inspector   Inspector @relation(fields: [inspectorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([inspectorId])
}

model Institution {
  id           String   @id @default(uuid()) @db.Uuid
  districtId   String   @db.Uuid
  name         String
  externalCode String?
  archivedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  district     District @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([districtId, name])
}

model AuditLog {
  id               String    @id @default(uuid()) @db.Uuid
  actorInspectorId String?   @db.Uuid
  districtId       String?   @db.Uuid
  action           String
  entityType       String
  entityId         String    @db.Uuid
  occurredAt       DateTime  @default(now())
  requestId        String?   @db.Uuid
  metadata         Json?
  actorInspector   Inspector? @relation(fields: [actorInspectorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  district         District?  @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([districtId, occurredAt])
}
