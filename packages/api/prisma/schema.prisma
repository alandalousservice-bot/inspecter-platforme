generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model District {
  invitations     TeacherInvitation[]
  id              String                        @id @default(uuid()) @db.Uuid
  name            String
  externalCode    String?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  memberships     InspectorDistrictMembership[]
  institutions    Institution[]
  auditEvents     AuditLog[]
  submissions     TeacherSubmission[]
  teachers        Teacher[]
  visits          PedagogicalVisit[]
  teacherRequests TeacherChangeRequest[]
}

model Inspector {
  teacherInvitations        TeacherInvitation[]
  teacherRequestDecisions   TeacherChangeRequest[]
  scheduleCorrections       ScheduleCorrection[] @relation("ScheduleCorrectionIssuer")
  scheduleDecisions         ScheduleCorrection[] @relation("ScheduleCorrectionDecision")
  id                        String                        @id @default(uuid()) @db.Uuid
  email                     String                        @unique
  name                      String?
  surname                   String?
  passwordHash              String
  status                    String
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  memberships               InspectorDistrictMembership[]
  sessions                  Session[]
  auditEvents               AuditLog[]
  decidedSubmissions        TeacherSubmission[]           @relation("TeacherSubmissionDecider")
  locationProposalDecisions TeacherSubmission[]           @relation("LocationProposalDecider")
  visits                    PedagogicalVisit[]
  finalizedReports          InspectionReport[]
  ownedFollowUps            FollowUp[]
}

model InspectorDistrictMembership {
  id          String    @id @default(uuid()) @db.Uuid
  inspectorId String    @db.Uuid
  districtId  String    @db.Uuid
  role        String
  validFrom   DateTime
  validTo     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  inspector   Inspector @relation(fields: [inspectorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  district    District  @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([inspectorId])
  @@index([districtId])
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  inspectorId String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  inspector   Inspector @relation(fields: [inspectorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([inspectorId])
}

model Institution {
  id                      String                          @id @default(uuid()) @db.Uuid
  districtId              String                          @db.Uuid
  name                    String
  externalCode            String?
  municipality            String?
  address                 String?
  directorPhone           String?
  latitude                Decimal?                        @db.Decimal(9, 6)
  longitude               Decimal?                        @db.Decimal(9, 6)
  locationSource          String?                         @db.VarChar(32)
  email                   String?                         @db.VarChar(254)
  archivedAt              DateTime?
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt
  district                District                        @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  teachers                Teacher[]
  visits                  PedagogicalVisit[]
  supplementaryWorkplaces TeacherSupplementaryWorkplace[]
  scheduleSlots           WeeklyScheduleSlot[]
  locationProposals       TeacherSubmission[]             @relation("LocationProposalInstitution")

  @@unique([id, districtId])
  @@index([districtId, name])
}

model TeacherSubmission {
  id                                        String                                               @id @default(uuid()) @db.Uuid
  districtId                                String                                               @db.Uuid
  submittedProfile                          Json
  status                                    String                                               @default("PENDING")
  submittedAt                               DateTime                                             @default(now())
  decidedAt                                 DateTime?
  decidedByInspectorId                      String?                                              @db.Uuid
  acceptedTeacherId                         String?                                              @unique @db.Uuid
  birthProvince                             String?                                              @db.VarChar(100)
  professionalFramework                     String?                                              @db.VarChar(120)
  firstEducationAppointmentDate             DateTime?                                            @db.Date
  firstEducationAppointmentDecisionNumber   String?                                              @db.VarChar(120)
  firstInstallationDate                     DateTime?                                            @db.Date
  traineeshipDate                           DateTime?                                            @db.Date
  institutionAppointmentDate                DateTime?                                            @db.Date
  institutionAppointmentNumber              String?                                              @db.VarChar(120)
  administrativeCategory                    String?                                              @db.VarChar(100)
  administrativeSection                     String?                                              @db.VarChar(100)
  administrativeGrade                       String?                                              @db.VarChar(100)
  administrativeClassificationEffectiveDate DateTime?                                            @db.Date
  personalAddress                           String?                                              @db.VarChar(300)
  declaredHomeInstitutionEmail              String?                                              @db.VarChar(254)
  proposedInstitutionLatitude               Decimal?                                             @db.Decimal(9, 6)
  proposedInstitutionLongitude              Decimal?                                             @db.Decimal(9, 6)
  locationProposalStatus                    String?                                              @db.VarChar(16)
  locationProposalDecidedAt                 DateTime?
  locationProposalDecidedByInspectorId      String?                                              @db.Uuid
  locationProposalInstitutionId             String?                                              @db.Uuid
  locationProposalDecisionReason            String?                                              @db.VarChar(32)
  district                                  District                                             @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decidedByInspector                        Inspector?                                           @relation("TeacherSubmissionDecider", fields: [decidedByInspectorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  acceptedTeacher                           Teacher?                                             @relation("AcceptedSubmission", fields: [acceptedTeacherId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  qualificationDeclarations                 TeacherSubmissionQualificationDeclaration[]
  supplementaryWorkplaceDeclarations        TeacherSubmissionSupplementaryWorkplaceDeclaration[]
  locationProposalDecidedByInspector        Inspector?                                           @relation("LocationProposalDecider", fields: [locationProposalDecidedByInspectorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  locationProposalInstitution               Institution?                                         @relation("LocationProposalInstitution", fields: [locationProposalInstitutionId, districtId], references: [id, districtId], onDelete: Restrict, onUpdate: Cascade)

  @@index([districtId, status, submittedAt])
  @@index([districtId, locationProposalStatus, submittedAt])
}

model TeacherSubmissionQualificationDeclaration {
  id                String            @id @default(uuid()) @db.Uuid
  submissionId      String            @db.Uuid
  position          Int               @db.SmallInt
  name              String            @db.VarChar(200)
  issuingBody       String?           @db.VarChar(200)
  qualificationDate DateTime?         @db.Date
  createdAt         DateTime          @default(now())
  submission        TeacherSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "tsq_submission_fk")

  @@unique([submissionId, position], map: "tsq_submission_position_key")
}

model TeacherSubmissionSupplementaryWorkplaceDeclaration {
  id                 String            @id @default(uuid()) @db.Uuid
  submissionId       String            @db.Uuid
  position           Int               @db.SmallInt
  institutionName    String            @db.VarChar(200)
  municipality       String?           @db.VarChar(150)
  institutionAddress String?           @db.VarChar(300)
  directorPhone      String?           @db.VarChar(20)
  createdAt          DateTime          @default(now())
  submission         TeacherSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "tsw_submission_fk")

  @@unique([submissionId, position], map: "tsw_submission_position_key")
}

model Teacher {
  id                                        String                          @id @default(uuid()) @db.Uuid
  districtId                                String                          @db.Uuid
  institutionId                             String?                         @db.Uuid
  name                                      String
  surname                                   String
  birthDate                                 DateTime?                       @db.Date
  placeOfBirth                              String?
  phone                                     String?
  email                                     String?
  professionalStatus                        String?
  employedAt                                DateTime?                       @db.Date
  confirmedAt                               DateTime?                       @db.Date
  qualifications                            String?
  professionalFramework                     String?                         @db.VarChar(120)
  firstEducationAppointmentDate             DateTime?                       @db.Date
  firstEducationAppointmentDecisionNumber   String?                         @db.VarChar(120)
  firstInstallationDate                     DateTime?                       @db.Date
  traineeshipDate                           DateTime?                       @db.Date
  institutionAppointmentDate                DateTime?                       @db.Date
  institutionAppointmentNumber              String?                         @db.VarChar(120)
  financialControllerVisaNumber             String?                         @db.VarChar(120)
  administrativeCategory                    String?                         @db.VarChar(100)
  administrativeSection                     String?                         @db.VarChar(100)
  administrativeGrade                       String?                         @db.VarChar(100)
  administrativeClassificationEffectiveDate DateTime?                       @db.Date
  birthProvince                             String?                         @db.VarChar(100)
  personalAddress                           String?                         @db.VarChar(300)
  administrativeNote                        String?                         @db.VarChar(1000)
  recordStatus                              String                          @default("ACTIVE")
  trainingStatus                            String?
  trainingVerifiedAt                        DateTime?
  archivedAt                                DateTime?
  createdAt                                 DateTime                        @default(now())
  updatedAt                                 DateTime                        @updatedAt
  district                                  District                        @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  institution                               Institution?                    @relation(fields: [institutionId, districtId], references: [id, districtId], onDelete: Restrict, onUpdate: Cascade)
  acceptedSubmission                        TeacherSubmission?              @relation("AcceptedSubmission")
  weeklySchedules                           WeeklySchedule[]
  visits                                    PedagogicalVisit[]
  qualificationsStructured                  TeacherQualification[]
  supplementaryWorkplaces                   TeacherSupplementaryWorkplace[]
  weeklyScheduleSlots                       WeeklyScheduleSlot[]
  account                                   TeacherAccount?
  scheduleCorrections                       ScheduleCorrection[]
  invitations                               TeacherInvitation[]
  changeRequests                            TeacherChangeRequest[]
  photos                                    TeacherPhoto[]
  teacherAuditEvents                        AuditLog[]                      @relation("TeacherAuditActor")

  @@unique([id, districtId])
  @@index([institutionId])
  @@index([districtId, surname, name, recordStatus])
}

model TeacherQualification {
  id                String    @id @default(uuid()) @db.Uuid
  teacherId         String    @db.Uuid
  name              String    @db.VarChar(200)
  issuingBody       String?   @db.VarChar(200)
  qualificationDate DateTime? @db.Date
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  teacher           Teacher   @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([teacherId, qualificationDate(sort: Desc, nulls: Last), createdAt(sort: Desc), id(sort: Desc)])
}

model TeacherSupplementaryWorkplace {
  id            String      @id @default(uuid()) @db.Uuid
  teacherId     String      @db.Uuid
  institutionId String      @db.Uuid
  districtId    String      @db.Uuid
  validFrom     DateTime    @db.Date
  validTo       DateTime?   @db.Date
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  teacher       Teacher     @relation(fields: [teacherId, districtId], references: [id, districtId], onDelete: Restrict, onUpdate: Cascade)
  institution   Institution @relation(fields: [institutionId, districtId], references: [id, districtId], onDelete: Restrict, onUpdate: Cascade)

  @@index([teacherId, validFrom(sort: Desc), id(sort: Desc)])
}

model WeeklySchedule {
  id           String               @id @default(uuid()) @db.Uuid
  teacherId    String               @db.Uuid
  academicYear String
  revision     Int                  @default(1)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  teacher      Teacher              @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  slots        WeeklyScheduleSlot[] @relation("ScheduleSlots")
  ownedSlots   WeeklyScheduleSlot[] @relation("SlotScheduleOwner")

  @@unique([teacherId, academicYear])
  @@unique([id, teacherId])
}

model PedagogicalVisit {
  id                      String            @id @default(uuid()) @db.Uuid
  districtId              String            @db.Uuid
  inspectorId             String            @db.Uuid
  teacherId               String            @db.Uuid
  institutionId           String            @db.Uuid
  institutionNameSnapshot String
  academicYear            String
  visitType               String?
  scheduledStartAt        DateTime?         @db.Timestamp(3)
  scheduledEndAt          DateTime?         @db.Timestamp(3)
  actualStartAt           DateTime?         @db.Timestamp(3)
  actualEndAt             DateTime?         @db.Timestamp(3)
  occurredAt              DateTime?         @db.Timestamp(3)
  status                  String            @default("PLANNED")
  revision                Int               @default(1)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  district                District          @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inspector               Inspector         @relation(fields: [inspectorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  teacher                 Teacher           @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  institution             Institution       @relation(fields: [institutionId, districtId], references: [id, districtId], onDelete: Restrict, onUpdate: Restrict)
  report                  InspectionReport?

  @@index([districtId, scheduledStartAt(sort: Desc), id(sort: Desc)])
  @@index([districtId, visitType])
  @@index([teacherId, scheduledStartAt])
  @@index([inspectorId, scheduledStartAt])
  @@index([institutionId, scheduledStartAt])
}

model InspectionReport {
  id                                       String                        @id @default(uuid()) @db.Uuid
  visitId                                  String                        @unique @db.Uuid
  reportType                               String                        @default("PEDAGOGICAL_ACCOMPANIMENT")
  templateSource                           String                        @default("INSPECTOR_AUTHORED")
  templateVersion                          Int                           @default(1)
  status                                   String                        @default("DRAFT")
  revision                                 Int                           @default(1)
  levelClass                               String?
  lessonTopic                              String?
  pedagogicalObservations                  String?
  strengths                                String?
  improvementAreas                         String?
  guidanceRecommendations                  String?
  inspectorConclusion                      String?
  finalizedAt                              DateTime?                     @db.Timestamp(3)
  finalizedByInspectorId                   String?                       @db.Uuid
  finalizedInspectorNameSnapshot           String?
  finalizedInspectorSurnameSnapshot        String?
  finalizedTeacherNameSnapshot             String?
  finalizedTeacherSurnameSnapshot          String?
  educationDirectorateText                 String?
  administrativeDivisionText               String?
  teacherClassificationText                String?
  teacherGradeText                         String?
  teacherNationalityText                   String?
  teacherEffectiveDateText                 String?
  teacherLastInspectionText                String?
  teacherAppointmentText                   String?
  teacherProfessionalFrameworkText         String?
  actualLessonDurationText                 String?
  studentCount                             Int?
  studentsPresentCount                     Int?
  studentsAbsentCount                      Int?
  lessonObjective                          String?
  pedagogicalGuidanceText                  String?
  practicalGuidanceText                    String?
  visitStrengthsText                       String?
  visitImprovementAreasText                String?
  tenureConclusionText                     String?
  generalAssessmentText                    String?
  markText                                 String?
  markWordsText                            String?
  pedagogicalMark                          Decimal?                      @db.Decimal(4, 2)
  finalizedTeacherBirthDateSnapshot        DateTime?                     @db.Date
  finalizedTeacherPlaceOfBirthSnapshot     String?
  finalizedTeacherQualificationsSnapshot   String?
  finalizedDistrictNameSnapshot            String?
  finalizedInstitutionMunicipalitySnapshot String?
  createdAt                                DateTime                      @default(now())
  updatedAt                                DateTime                      @updatedAt
  visit                                    PedagogicalVisit              @relation(fields: [visitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  finalizedByInspector                     Inspector?                    @relation(fields: [finalizedByInspectorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  followUps                                FollowUp[]
  observations                             InspectionReportObservation[]

  @@unique([id, reportType, templateVersion])
  @@index([finalizedByInspectorId])
}

model InspectionReportObservation {
  id              String           @id @default(uuid()) @db.Uuid
  reportId        String           @db.Uuid
  reportType      String           @default("INSPECTOR_VISIT")
  templateVersion Int              @default(1)
  criterionKey    String
  valueText       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  report          InspectionReport @relation(fields: [reportId, reportType, templateVersion], references: [id, reportType, templateVersion], onDelete: Restrict, onUpdate: Restrict)

  @@unique([reportId, criterionKey])
  @@index([reportId, reportType, templateVersion])
}

model FollowUp {
  id               String           @id @default(uuid()) @db.Uuid
  reportId         String           @db.Uuid
  ownerInspectorId String           @db.Uuid
  status           String           @default("OPEN")
  note             String
  dueDate          DateTime         @db.Date
  completionNote   String?
  completedAt      DateTime?        @db.Timestamp(3)
  revision         Int              @default(1)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  report           InspectionReport @relation(fields: [reportId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownerInspector   Inspector        @relation(fields: [ownerInspectorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([reportId, dueDate, id])
  @@index([status, dueDate, id])
  @@index([ownerInspectorId])
}

model WeeklyScheduleSlot {
  id             String          @id @default(uuid()) @db.Uuid
  scheduleId     String          @db.Uuid
  teacherId      String?         @db.Uuid
  districtId     String?         @db.Uuid
  institutionId  String?         @db.Uuid
  validFrom      DateTime?       @db.Date
  validTo        DateTime?       @db.Date
  workplaceBasis String?
  dayOfWeek      Int
  startMinute    Int
  endMinute      Int
  levelLabel     String?
  groupLabel     String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  schedule       WeeklySchedule  @relation("ScheduleSlots", fields: [scheduleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scheduleOwner  WeeklySchedule? @relation("SlotScheduleOwner", fields: [scheduleId, teacherId], references: [id, teacherId], onDelete: Restrict, onUpdate: Cascade)
  teacher        Teacher?        @relation(fields: [teacherId, districtId], references: [id, districtId], onDelete: Restrict, onUpdate: Cascade)
  institution    Institution?    @relation(fields: [institutionId, districtId], references: [id, districtId], onDelete: Restrict, onUpdate: Cascade)

  @@index([scheduleId, dayOfWeek, startMinute, endMinute])
  @@index([institutionId])
  @@index([teacherId, validFrom, validTo, dayOfWeek])
  @@index([dayOfWeek, startMinute])
}

model AuditLog {
  id               String     @id @default(uuid()) @db.Uuid
  actorInspectorId String?    @db.Uuid
  actorTeacherId   String?    @db.Uuid
  districtId       String?    @db.Uuid
  action           String
  entityType       String
  entityId         String     @db.Uuid
  occurredAt       DateTime   @default(now())
  requestId        String?    @db.Uuid
  metadata         Json?
  actorInspector   Inspector? @relation(fields: [actorInspectorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  district         District?  @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorTeacher     Teacher?   @relation("TeacherAuditActor", fields: [actorTeacherId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([districtId, occurredAt])
}

model TeacherAccount {
  id           String           @id @default(uuid()) @db.Uuid
  teacherId    String           @unique @db.Uuid
  loginEmail   String           @unique @db.VarChar(254)
  passwordHash String
  status       String           @default("ACTIVE")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  teacher      Teacher          @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessions     TeacherSession[]
}

model TeacherSession {
  id        String         @id @default(uuid()) @db.Uuid
  accountId String         @db.Uuid
  tokenHash String         @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  account   TeacherAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([accountId])
}

model TeacherInvitation {
  district    District  @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inspector   Inspector @relation(fields: [inspectorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id          String    @id @default(uuid()) @db.Uuid
  teacherId   String    @db.Uuid
  districtId  String    @db.Uuid
  inspectorId String    @db.Uuid
  loginEmail  String    @db.VarChar(254)
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([teacherId, expiresAt])
}

model TeacherChangeRequest {
  decisionInspector   Inspector? @relation(fields: [decisionInspectorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id                  String     @id @default(uuid()) @db.Uuid
  teacherId           String     @db.Uuid
  districtId          String     @db.Uuid
  kind                String
  status              String     @default("PENDING")
  payload             Json
  baselineUpdatedAt   DateTime
  revision            Int        @default(1)
  decisionInspectorId String?    @db.Uuid
  decisionNote        String?    @db.VarChar(500)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  teacher             Teacher    @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  district            District   @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([districtId, status, createdAt, id])
  @@index([teacherId, createdAt, id])
}

model TeacherPhoto {
  id          String   @id @default(uuid()) @db.Uuid
  teacherId   String   @db.Uuid
  contentType String   @db.VarChar(32)
  byteLength  Int
  sanitizationVersion Int?
  storageKey  String   @unique @db.Uuid
  createdAt   DateTime @default(now())
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([teacherId, createdAt(sort: Desc), id(sort: Desc)])
}

model ScheduleCorrection {
  inspector        Inspector? @relation("ScheduleCorrectionIssuer", fields: [inspectorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decisionInspector Inspector? @relation("ScheduleCorrectionDecision", fields: [decisionInspectorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id               String    @id @default(uuid()) @db.Uuid
  teacherId        String    @db.Uuid
  inspectorId      String?   @db.Uuid
  decisionInspectorId String? @db.Uuid
  origin           String    @default("INSPECTOR_CORRECTION")
  academicYear     String
  note             String?   @db.VarChar(500)
  decisionNote     String?   @db.VarChar(500)
  status           String    @default("REQUESTED")
  scheduleRevision Int
  revision         Int       @default(1)
  proposedSlots    Json?
  previousSlots    Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  teacher          Teacher   @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([teacherId, academicYear, createdAt])
}
