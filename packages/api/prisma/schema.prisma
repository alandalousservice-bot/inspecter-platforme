generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model District {
  id           String                        @id @default(uuid()) @db.Uuid
  name         String
  externalCode String?
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  memberships  InspectorDistrictMembership[]
  institutions Institution[]
  auditEvents  AuditLog[]
  submissions  TeacherSubmission[]
  teachers     Teacher[]
  visits       PedagogicalVisit[]
}

model Inspector {
  id                 String                        @id @default(uuid()) @db.Uuid
  email              String                        @unique
  name               String?
  surname            String?
  passwordHash       String
  status             String
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  memberships        InspectorDistrictMembership[]
  sessions           Session[]
  auditEvents        AuditLog[]
  decidedSubmissions TeacherSubmission[]           @relation("TeacherSubmissionDecider")
  visits             PedagogicalVisit[]
  finalizedReports   InspectionReport[]
  ownedFollowUps     FollowUp[]
}

model InspectorDistrictMembership {
  id          String    @id @default(uuid()) @db.Uuid
  inspectorId String    @db.Uuid
  districtId  String    @db.Uuid
  role        String
  validFrom   DateTime
  validTo     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  inspector   Inspector @relation(fields: [inspectorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  district    District  @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([inspectorId])
  @@index([districtId])
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  inspectorId String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  inspector   Inspector @relation(fields: [inspectorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([inspectorId])
}

model Institution {
  id            String             @id @default(uuid()) @db.Uuid
  districtId    String             @db.Uuid
  name          String
  externalCode  String?
  municipality  String?
  address       String?
  directorPhone String?
  archivedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  district      District           @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  teachers      Teacher[]
  visits        PedagogicalVisit[]

  @@unique([id, districtId])
  @@index([districtId, name])
}

model TeacherSubmission {
  id                   String     @id @default(uuid()) @db.Uuid
  districtId           String     @db.Uuid
  submittedProfile     Json
  status               String     @default("PENDING")
  submittedAt          DateTime   @default(now())
  decidedAt            DateTime?
  decidedByInspectorId String?    @db.Uuid
  acceptedTeacherId    String?    @unique @db.Uuid
  district             District   @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decidedByInspector   Inspector? @relation("TeacherSubmissionDecider", fields: [decidedByInspectorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  acceptedTeacher      Teacher?   @relation("AcceptedSubmission", fields: [acceptedTeacherId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([districtId, status, submittedAt])
}

model Teacher {
  id                 String             @id @default(uuid()) @db.Uuid
  districtId         String             @db.Uuid
  institutionId      String?            @db.Uuid
  name               String
  surname            String
  birthDate          DateTime?          @db.Date
  placeOfBirth       String?
  phone              String?
  email              String?
  professionalStatus String?
  employedAt         DateTime?          @db.Date
  confirmedAt        DateTime?          @db.Date
  qualifications     String?
  recordStatus       String             @default("ACTIVE")
  archivedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  district           District           @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  institution        Institution?       @relation(fields: [institutionId, districtId], references: [id, districtId], onDelete: Restrict, onUpdate: Cascade)
  acceptedSubmission TeacherSubmission? @relation("AcceptedSubmission")
  weeklySchedules    WeeklySchedule[]
  visits             PedagogicalVisit[]

  @@index([institutionId])
  @@index([districtId, surname, name, recordStatus])
}

model WeeklySchedule {
  id           String               @id @default(uuid()) @db.Uuid
  teacherId    String               @db.Uuid
  academicYear String
  revision     Int                  @default(1)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  teacher      Teacher              @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  slots        WeeklyScheduleSlot[]

  @@unique([teacherId, academicYear])
}

model PedagogicalVisit {
  id                      String            @id @default(uuid()) @db.Uuid
  districtId              String            @db.Uuid
  inspectorId             String            @db.Uuid
  teacherId               String            @db.Uuid
  institutionId           String            @db.Uuid
  institutionNameSnapshot String
  academicYear            String
  scheduledStartAt        DateTime          @db.Timestamp(3)
  scheduledEndAt          DateTime          @db.Timestamp(3)
  occurredAt              DateTime?         @db.Timestamp(3)
  status                  String            @default("PLANNED")
  revision                Int               @default(1)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  district                District          @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inspector               Inspector         @relation(fields: [inspectorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  teacher                 Teacher           @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  institution             Institution       @relation(fields: [institutionId, districtId], references: [id, districtId], onDelete: Restrict, onUpdate: Restrict)
  report                  InspectionReport?

  @@index([districtId, scheduledStartAt(sort: Desc), id(sort: Desc)])
  @@index([teacherId, scheduledStartAt])
  @@index([inspectorId, scheduledStartAt])
  @@index([institutionId, scheduledStartAt])
}

model InspectionReport {
  id                                String           @id @default(uuid()) @db.Uuid
  visitId                           String           @unique @db.Uuid
  reportType                        String           @default("PEDAGOGICAL_ACCOMPANIMENT")
  templateSource                    String           @default("INSPECTOR_AUTHORED")
  templateVersion                   Int              @default(1)
  status                            String           @default("DRAFT")
  revision                          Int              @default(1)
  levelClass                        String?
  lessonTopic                       String?
  pedagogicalObservations           String?
  strengths                         String?
  improvementAreas                  String?
  guidanceRecommendations           String?
  inspectorConclusion               String?
  finalizedAt                       DateTime?        @db.Timestamp(3)
  finalizedByInspectorId            String?          @db.Uuid
  finalizedInspectorNameSnapshot    String?
  finalizedInspectorSurnameSnapshot String?
  finalizedTeacherNameSnapshot      String?
  finalizedTeacherSurnameSnapshot   String?
  createdAt                         DateTime         @default(now())
  updatedAt                         DateTime         @updatedAt
  visit                             PedagogicalVisit @relation(fields: [visitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  finalizedByInspector              Inspector?       @relation(fields: [finalizedByInspectorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  followUps                         FollowUp[]

  @@index([finalizedByInspectorId])
}

model FollowUp {
  id               String           @id @default(uuid()) @db.Uuid
  reportId         String           @db.Uuid
  ownerInspectorId String           @db.Uuid
  status           String           @default("OPEN")
  note             String
  dueDate          DateTime         @db.Date
  completionNote   String?
  completedAt      DateTime?        @db.Timestamp(3)
  revision         Int              @default(1)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  report           InspectionReport @relation(fields: [reportId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownerInspector   Inspector        @relation(fields: [ownerInspectorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([reportId, dueDate, id])
  @@index([status, dueDate, id])
  @@index([ownerInspectorId])
}

model WeeklyScheduleSlot {
  id          String         @id @default(uuid()) @db.Uuid
  scheduleId  String         @db.Uuid
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  levelLabel  String?
  groupLabel  String?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  schedule    WeeklySchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([scheduleId, dayOfWeek, startMinute, endMinute])
  @@index([dayOfWeek, startMinute])
}

model AuditLog {
  id               String     @id @default(uuid()) @db.Uuid
  actorInspectorId String?    @db.Uuid
  districtId       String?    @db.Uuid
  action           String
  entityType       String
  entityId         String     @db.Uuid
  occurredAt       DateTime   @default(now())
  requestId        String?    @db.Uuid
  metadata         Json?
  actorInspector   Inspector? @relation(fields: [actorInspectorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  district         District?  @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([districtId, occurredAt])
}
